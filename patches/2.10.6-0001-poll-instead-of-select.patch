+// Copyright (c) Orbbec Inc. All Rights Reserved.
+// Licensed under the MIT License.
+//
+// Waiting for socket / descriptor readiness without select()'s FD_SETSIZE limit (patch of the TUM-CONAN recipe).
+// select() can only watch descriptors below FD_SETSIZE (1024): glibc aborts the process for a higher one ("bit out of
+// range 0 - FD_SETSIZE on fd_set"), and a process with many open files (shared-memory transports, many cameras)
+// opens its sockets above it. POSIX: poll(), any descriptor number. Windows: select() (its fd_set is a list of
+// sockets, without that limit).
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#if defined(WIN32) || defined(_WIN32) || defined(WINCE)
+#include <winsock2.h>
+#else
+#include <poll.h>
+#endif
+
+namespace libobsensor {
+namespace fdwait {
+
+enum : short { kRead = 1, kWrite = 2, kExcept = 4 };
+
+struct Entry {
+    int64_t fd    = -1;
+    short   want  = 0;  // kRead | kWrite | kExcept
+    short   ready = 0;  // set by wait(): the wanted conditions that hold
+};
+
+// Waits until one of the entries is ready or timeoutMs (< 0: forever) passed. As select(): an error or a hang-up makes
+// a socket readable and writable. Returns the number of ready entries, 0 on timeout, < 0 on error (errno, or
+// WSAGetLastError() on Windows).
+inline int wait(Entry *entries, size_t count, int timeoutMs) {
+    for(size_t i = 0; i < count; ++i) {
+        entries[i].ready = 0;
+    }
+#if defined(WIN32) || defined(_WIN32) || defined(WINCE)
+    fd_set readSet, writeSet, exceptSet;
+    FD_ZERO(&readSet);
+    FD_ZERO(&writeSet);
+    FD_ZERO(&exceptSet);
+    for(size_t i = 0; i < count; ++i) {
+        SOCKET s = static_cast<SOCKET>(entries[i].fd);
+        if(entries[i].want & kRead)
+            FD_SET(s, &readSet);
+        if(entries[i].want & kWrite)
+            FD_SET(s, &writeSet);
+        if(entries[i].want & kExcept)
+            FD_SET(s, &exceptSet);
+    }
+    struct timeval tv;
+    tv.tv_sec  = timeoutMs / 1000;
+    tv.tv_usec = (timeoutMs % 1000) * 1000;
+    int res    = select(0, &readSet, &writeSet, &exceptSet, timeoutMs < 0 ? nullptr : &tv);
+    if(res > 0) {
+        res = 0;
+        for(size_t i = 0; i < count; ++i) {
+            SOCKET s = static_cast<SOCKET>(entries[i].fd);
+            if((entries[i].want & kRead) && FD_ISSET(s, &readSet))
+                entries[i].ready |= kRead;
+            if((entries[i].want & kWrite) && FD_ISSET(s, &writeSet))
+                entries[i].ready |= kWrite;
+            if((entries[i].want & kExcept) && FD_ISSET(s, &exceptSet))
+                entries[i].ready |= kExcept;
+            if(entries[i].ready)
+                ++res;
+        }
+    }
+    return res;
+#else
+    std::vector<struct pollfd> fds(count);
+    for(size_t i = 0; i < count; ++i) {
+        fds[i].fd      = static_cast<int>(entries[i].fd);
+        fds[i].events  = static_cast<short>(((entries[i].want & kRead) ? POLLIN : 0) | ((entries[i].want & kWrite) ? POLLOUT : 0)
+                                           | ((entries[i].want & kExcept) ? POLLPRI : 0));
+        fds[i].revents = 0;
+    }
+    int res = ::poll(fds.empty() ? nullptr : fds.data(), static_cast<nfds_t>(count), timeoutMs);
+    if(res > 0) {
+        res = 0;
+        for(size_t i = 0; i < count; ++i) {
+            const short r = fds[i].revents;
+            if((entries[i].want & kRead) && (r & (POLLIN | POLLHUP | POLLERR | POLLNVAL)))
+                entries[i].ready |= kRead;
+            if((entries[i].want & kWrite) && (r & (POLLOUT | POLLHUP | POLLERR | POLLNVAL)))
+                entries[i].ready |= kWrite;
+            if((entries[i].want & kExcept) && (r & POLLPRI))
+                entries[i].ready |= kExcept;
+            if(entries[i].ready)
+                ++res;
+        }
+    }
+    return res;
+#endif
+}
+
+// One descriptor: > 0 ready (the conditions in *ready), 0 timeout, < 0 error.
+inline int waitOne(int64_t fd, short want, int timeoutMs, short *ready = nullptr) {
+    Entry e;
+    e.fd    = fd;
+    e.want  = want;
+    int res = wait(&e, 1, timeoutMs);
+    if(ready)
+        *ready = e.ready;
+    return res;
+}
+
+}  // namespace fdwait
+}  // namespace libobsensor
